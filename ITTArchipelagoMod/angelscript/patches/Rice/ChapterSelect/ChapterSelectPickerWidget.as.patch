 	void Tick(FGeometry MyGeometry, float InDeltaTime)
 	{
 		bHasTickedForSound = true;
+
+		// Archipelago: refresh locks and move off a locked chapter.
+		if (ChapterDatabase == nullptr || CurrentChapterIndex == -1)
+			return;
+		if (ArchipelagoUnlockedChapters != AppliedArchipelagoMask)
+		{
+			AppliedArchipelagoMask = ArchipelagoUnlockedChapters;
+			UpdateSelectedSubChapter();
+		}
+		if (SelectedChapter.bIsMinigame || IsArchipelagoChapterUnlocked(CurrentChapterIndex) || !CanControlSelection())
+			return;
+
+		int Target = FindUnlockedChapterInGroup(CurrentGroupIndex);
+		if (Target == -1)
+		{
+			int Group = FindNavigableGroup(-1);
+			if (Group == -1)
+				Group = FindNavigableGroup(1);
+			if (Group != -1)
+				Target = FindUnlockedChapterInGroup(Group);
+		}
+		if (Target != -1)
+			SelectChapterInternal(Target);
 	}
 
