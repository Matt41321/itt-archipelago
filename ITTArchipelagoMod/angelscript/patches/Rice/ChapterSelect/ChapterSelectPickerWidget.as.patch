 	UFUNCTION()
+	bool IsArchipelagoChapterUnlocked(int ChapterIndex) const
+	{
+		return ChapterIndex < 0 || (ArchipelagoUnlockedChapters & (int64(1) << ChapterIndex)) != 0;
+	}
+
+	// Archipelago: minigames aren't locked here.
+	bool IsArchipelagoChapterAllowed(const FHazeChapter& Chapter) const
+	{
+		return Chapter.bIsMinigame
+			|| IsArchipelagoChapterUnlocked(ChapterDatabase.GetChapterIndexForProgressPoint(Chapter.ProgressPoint));
+	}
+
+	// Archipelago: first unlocked chapter in the group.
+	int FindUnlockedChapterInGroup(int GroupIndex)
+	{
+		for (const FHazeChapter& Chapter : ChapterDatabase.GetChaptersInGroup(GroupIndex))
+		{
+			if (Chapter.bIsMinigame || !Save::IsChapterSelectUnlocked(Chapter.ProgressPoint))
+				continue;
+			int ChapterIndex = ChapterDatabase.GetChapterIndexForProgressPoint(Chapter.ProgressPoint);
+			if (IsArchipelagoChapterUnlocked(ChapterIndex))
+				return ChapterIndex;
+		}
+		return -1;
+	}
+
+	// Archipelago: next group with an unlocked chapter, or -1.
+	int FindNavigableGroup(int Direction)
+	{
+		for (int GroupIndex = CurrentGroupIndex + Direction;
+			GroupIndex >= 0 && GroupIndex < ChapterDatabase.GetChapterGroupCount();
+			GroupIndex += Direction)
+		{
+			const FHazeChapterGroup& Group = ChapterDatabase.GetChapterGroupByIndex(GroupIndex);
+			if (!Save::IsChapterSelectUnlocked(Group.ProgressPoint))
+				return -1;
+			if (FindUnlockedChapterInGroup(GroupIndex) != -1)
+				return GroupIndex;
+		}
+		return -1;
+	}
+
